@page
@model M_Shop.Pages.Admin.EditModel
@{
}
<h1> ویرایش کالا</h1>

<form method="post" enctype="MultiPart/form-Data">
    
    <input type="hidden" asp-for="AddEditeProductViewModel.Id" />
    <dl class="dl-horizontal">
        <div class="my-3"> <dd><label asp-for="AddEditeProductViewModel.Name"></label></dd>
            <dt>
                <input asp-for="AddEditeProductViewModel.Name" class="form-control"/>
                <span asp-validation-for="AddEditeProductViewModel"></span>
            </dt></div>
       
        <div class="my-3"><dd><label asp-for="AddEditeProductViewModel.Description"></label></dd>
            <dt>
                <textarea asp-for="AddEditeProductViewModel.Description" style="width:100%" rows="10"> </textarea>
                <span asp-validation-for="AddEditeProductViewModel"></span>
            </dt></div>
        
        <div class="my-3"><dd><label asp-for="AddEditeProductViewModel.Price"></label></dd>
            <dt>
                <input asp-for="AddEditeProductViewModel.Price" class="form-control"/>
                <span asp-validation-for="AddEditeProductViewModel"></span>
            </dt></div>
        
        <div class="my-3"> <dd><label asp-for="AddEditeProductViewModel.QuantityStoke"></label></dd>
            <dt>
                <input asp-for="AddEditeProductViewModel.QuantityStoke" class="form-control"/>
                <span asp-validation-for="AddEditeProductViewModel"></span>
            </dt></div>
       
        <div class="my-3"> <dd><label asp-for="AddEditeProductViewModel.Picture"></label></dd>
            <dt>
                <input asp-for="AddEditeProductViewModel.Picture"/>
                <span asp-validation-for="AddEditeProductViewModel.Picture"></span>
            </dt></div>

        <div class="my-3"> <dd></dd>
            <dt>
                <input  value="ویرایش" type="submit" class="btn btn-dark"/>
            </dt>
        </div>
    </dl>
</form>
