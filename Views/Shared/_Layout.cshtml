<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] فروشگاه من</title>
    <link href="~/css/bootstrap-rtl.min.css" rel="stylesheet" />
    <link href="~/css/bootstrap-rtl.css" rel="stylesheet" />
    <link href="~/css/custom.css" rel="stylesheet" />
    <link href="~/css/bootstrap.css" rel="stylesheet" />
    <link href="https://cdn.rawgit.com/rastikerdar/sahel-font/v1.0.0-alpha23/dist/font-face.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/css/main.css" rel="stylesheet" />

</head>
<body class="rtl">
    <header>
        @*<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">فروشگاه من</a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">خانه</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="ContactUs">تماس با ما</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>*@

        <nav class="navbar navbar-expand-lg navbar-dark  rtl bg-dark mt-2">
            <a class="navbar-brand text-light" asp-area="" asp-controller="Home" asp-action="Index">M-Shop</a>
            <button class="navbar-toggler text-dark" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item active">
                        <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">خانه <span class="sr-only">(current)</span></a>
                    </li>
                    
                    <partial name="_DropdownListGroup"/>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light">@User.Identity.Name خوش آمید...</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  text-light" tabindex="-1" aria-disabled="true" asp-controller="Account" asp-action="Logout">خروج</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Account" asp-action="Register">ثبت نام</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  text-light" tabindex="-1" aria-disabled="true" asp-controller="Account" asp-action="Login">ورود</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link  text-light" tabindex="-1" aria-disabled="true" asp-area="" asp-controller="Home" asp-action="ContactUs">تماس با ما</a>
                    </li>
                </ul>
                <form class="form-inline my-2 my-lg-0" asp-action="Index" asp-controller="Home" method="get">
                    <input class="form-control mr-sm-2" type="search" name="Search" placeholder="Search" aria-label="Search">
                    <button class="btn btn-outline-light my-2 my-sm-0" type="submit">Search</button>
                </form>
            </div>
        </nav>

    </header>
    <div class="container">
        <div class="row">
            <div class="col-md-3 " style="margin-top: 4rem;">@await Component.InvokeAsync("ListGroupComponent")
                </div>
            <div class="col-md-9"> @RenderBody()</div>
        </div>
    </div>

