
@{
    ViewData["Title"] = "ContactUs";
}
<!-- Section: Contact v.1 -->
<style>
    .map-container-section {
        overflow:hidden;
        padding-bottom:56.25%;
        position:relative;
        height:0;
    }
    .map-container-section iframe {
        left:0;
        top:0;
        height:100%;
        width:100%;
        position:absolute;
    }
</style>
<section class="my-5">

    <!-- Section heading -->
    <h2 class="h1-responsive font-weight-bold text-center my-5"> فرم تماس با ما</h2>
    <!-- Section description -->
    <p class="text-center w-responsive mx-auto pb-5 text-justify">
        کاربر گرامی و محترم در صورتی که مشکل ایجاد شده رفع نگردید و مشکل شما نیاز به پیگیری های لازم از طرف تیم ما را دارد خواهشمند است از طریق راه های زیر با ما ارتباط برقرار کنید 
        وهمینطور آماده ارایه انتقادات و پیشنهادات و نظرات دلگرم کننده شما هستیم
    </p>

    <!-- Grid row -->
    <div class="row">

        <!-- Grid column -->
        <div class="col-lg-5 mb-lg-0 mb-4">

            <!-- Form with header -->
            <div class="card">
                <div class="card-body">
                    <!-- Header -->
                    <div class="form-header blue accent-1">
                        <h3 class="mt-2"><i class="fas fa-envelope"></i> بنویسید برای ما:</h3>
                    </div>
                    <p class="dark-grey-text"></p>
                    <!-- Body -->
                    <div class="md-form">
                        <label for="form-name">نام شما</label>
                        <i class="fas fa-user prefix grey-text"></i>
                        <input type="text" id="form-name" class="form-control">

                    </div>
                    <div class="md-form">
                        <label for="form-email">ایمیل شما</label>
                        <i class="fas fa-envelope prefix grey-text"></i>
                        <input type="text" id="form-email" class="form-control">

                    </div>
                    <div class="md-form">
                        <label for="form-Subject">موضوع</label>
                        <i class="fas fa-tag prefix grey-text"></i>
                        <input type="text" id="form-Subject" class="form-control">
                        
                    </div>
                    <div class="md-form">
                        <label for="form-text">فرستادن پیام</label>
                        <i class="fas fa-pencil-alt prefix grey-text"></i>
                        <textarea id="form-text" class="form-control md-textarea" rows="3"></textarea>

                    </div>
                    <div class="text-left mt-3">
                        <button class="btn btn-primary">ثبت</button>
                    </div>
                </div>
            </div>
            <!-- Form with header -->

        </div>
        <!-- Grid column -->
        <!-- Grid column -->
        <div class="col-lg-7">

            <!--Google map-->
            <div id="map-container-section" class="z-depth-1-half map-container-section mb-4" style="height: 400px">
                <iframe src="https://maps.google.com/maps?q=Manhatan&t=&z=15&ie=UTF8&iwloc=&output=embed" frameborder="0"
                        style="border:0" allowfullscreen></iframe>
            </div>
            <!-- Buttons-->
            <div class="row text-center">
                <div class="col-md-4">
                    <a class="btn-primary">
                        <i class="fas fa-map-marker-alt"></i>
                    </a>
                    <p>اصفهان</p>
                    <p class="mb-md-0">ایران</p>
                </div>
                <div class="col-md-4">
                    <a class="btn-primary">
                        <i class="fas fa-phone"></i>
                    </a>
                    <p>+9220705761</p>
                    <p class="mb-md-0">دوشنبه تا جمعه,از ساعت 8:00-22:00</p>
                </div>
                <div class="col-md-4">
                    <a class="btn-primary">
                        <i class="fas fa-envelope"></i>
                    </a>
                    <p>classicus.ma@gmail.com</p>
                    <p class="mb-0">mahdiamini@yahoo.com</p>
                </div>
            </div>

        </div>
        <!-- Grid column -->

    </div>
    <!-- Grid row -->

</section>
<!-- Section: Contact v.1 -->